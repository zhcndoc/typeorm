FROM --platform=$BUILDPLATFORM node:24-bookworm AS build

RUN npm install -g pnpm@10.34.5

WORKDIR /app

COPY docs/package.json docs/pnpm-lock.yaml docs/pnpm-workspace.yaml ./docs/
RUN cd docs && pnpm install --frozen-lockfile

COPY --exclude=node_modules \
    --exclude=docs/node_modules \
    --exclude=docs/.docusaurus \
    --exclude=docs/build \
    . .

RUN cd docs && pnpm run build

FROM caddy:2-alpine

COPY --from=build /app/docs/build /srv

COPY <<'EOF' /etc/caddy/Caddyfile
:80 {
    root * /srv
    encode zstd gzip

    try_files {path} {path}.html
    file_server

    handle_errors 404 {
        rewrite * /404.html
        file_server
    }
}
EOF

EXPOSE 80
